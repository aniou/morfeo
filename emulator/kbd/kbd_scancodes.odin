import "lib:emu"


SC          :: [4]u32                            // a scancode sequence, sent up to first 0
SCAN_SET    :: [emu.KEY]SC                       // single sequence - or for down, clear bit for up

// "restore" key generates NMI and is handled on GUI level
//
